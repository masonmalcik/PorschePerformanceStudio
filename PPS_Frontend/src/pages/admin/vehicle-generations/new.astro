---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CreateVehicleGenerationForm from '../../../components/CreateVehicleGenerationForm';
import AdminToolLinks from '../../../components/AdminToolLinks.astro';
---
<BaseLayout title="Create New Generation | PPS Admin Tools" description="Create a vehicle generation in Porsche Performance Studio.">
  <section class="admin-intro">
    <div>
      <h1>Create New Generation</h1>
      <p>Add a vehicle generation to the Porsche Performance Studio catalog.</p>
      <AdminToolLinks />
