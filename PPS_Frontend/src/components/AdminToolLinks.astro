---
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const path=Astro.url.pathname.startsWith(base)?Astro.url.pathname.slice(base.length)||'/':Astro.url.pathname;
const tools=[
  ['Model','vehicle-models'],
  ['Generation','vehicle-generations'],
  ['Trim','vehicle-trims'],
  ['Configuration','vehicle-configurations'],
  ['Engine','engines'],
  ['Brand','brands'],
  ['Category','categories'],
  ['Product','products'],
  ['Fitment','product-fitments'],
];
---
<nav class="admin-links" aria-label="Admin tools">
  {tools.map(([label,segment]) => {
    const root=`/admin/${segment}`;
    const active=path.startsWith(`${root}/`);
    return (
      <details name="admin-tools" class:list={{'admin-tool-menu':true,active}} open={active}>
        <summary>{label}</summary>
        <div class="admin-tool-options">
          <a class:list={{active:path===`${root}/new`}} href={`${base}${root}/new`}>Create</a>
          <a class:list={{active:path===`${root}/update`}} href={`${base}${root}/update`}>Update</a>
        </div>
      </details>
    );
  })}
</nav>
