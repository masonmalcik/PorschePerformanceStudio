MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DATABASE=pps_catalog
ASSET_ROOT=assets
RUST_LOG=info
ADMIN_AUTH_MODE=development
ADMIN_DEV_TOKEN=replace-with-a-long-random-local-token
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE
COGNITO_CLIENT_ID=replace-with-cognito-app-client-id
COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE/.well-known/jwks.json
REDIS_MODE=standalone
REDIS_CLUSTER_URLS=redis://127.0.0.1:6379
REDIS_POOL_SIZE=8
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_TIMEOUT_MS=500
