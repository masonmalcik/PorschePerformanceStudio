generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model PaymentTransaction {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  userId                String        @map("user_id") @db.VarChar(128)
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  idempotencyKey        String        @unique @map("idempotency_key") @db.VarChar(128)
  amount                Int
  currency              String        @db.Char(3)
  status                PaymentStatus @default(PENDING)
  errorMessage          String?       @map("error_message") @db.VarChar(1000)
  lastEventCreated      Int           @default(0) @map("last_event_created")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("payment_transactions")
}

model StripeWebhookEvent {
  eventId     String   @id @map("event_id") @db.VarChar(255)
  eventType   String   @map("event_type") @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("stripe_webhook_events")
}

model PaymentOutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  aggregateId String    @map("aggregate_id") @db.Uuid
  type        String    @db.VarChar(100)
  payload     Json
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, createdAt])
  @@map("payment_outbox_events")
}
