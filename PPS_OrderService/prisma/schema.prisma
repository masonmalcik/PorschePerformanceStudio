generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  STOCK_RESERVED
  PAID
  CONFIRMED
  CANCELLED
  FAILED
  COMPENSATED
}

model Order {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.VarChar(128)
  status         OrderStatus    @default(PENDING)
  totalAmount    Decimal        @map("total_amount") @db.Decimal(14, 2)
  trackingId     String?        @unique @map("tracking_id") @db.VarChar(128)
  idempotencyKey String         @unique @map("idempotency_key") @db.VarChar(128)
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  items          OrderItem[]
  history        OrderHistory[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String   @map("product_id") @db.VarChar(128)
  quantity     Int
  pricePerUnit Decimal  @map("price_per_unit") @db.Decimal(14, 2)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([orderId])
  @@map("order_items")
}

model OrderHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  reason     String?      @db.VarChar(500)
  eventId    String?      @map("event_id") @db.VarChar(128)
  createdAt  DateTime     @default(now()) @map("created_at")
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_history")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  aggregateId String    @map("aggregate_id") @db.Uuid
  type        String    @db.VarChar(100)
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.VarChar(128)
  eventType   String   @map("event_type") @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}
