{
  "$schema": "https://www.krakend.io/schema/v2.13/krakend.json",
  "version": 3,
  "name": "PPS API Gateway",
  "port": 8080,
  "timeout": "5s",
  "cache_ttl": "300s",
  "dns_cache_ttl": "30s",
  "output_encoding": "no-op",
  "read_timeout": "10s",
  "write_timeout": "10s",
  "idle_timeout": "60s",
  "read_header_timeout": "5s",
  "extra_config": {
    "security/cors": {
      "allow_origins": ["http://localhost:3000", "http://localhost:4321", "http://localhost:5173"],
      "allow_methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "allow_headers": ["Authorization", "Content-Type", "If-None-Match", "X-PPS-Admin-Key", "X-Request-ID"],
      "expose_headers": ["Cache-Control", "ETag", "X-Request-ID"],
      "max_age": "12h"
    },
    "telemetry/opentelemetry": {
      "service_name": "pps-api-gateway",
      "metric_reporting_period": 10,
      "exporters": {
        "prometheus": [{
          "name": "pps_gateway_metrics",
          "listen_ip": "0.0.0.0",
          "port": 9091,
          "process_metrics": true,
          "go_metrics": true
        }],
        "otlp": [{
          "name": "pps_otel_collector",
          "host": "otel-collector",
          "port": 4317,
          "use_http": false
        }]
      }
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/v1/auth/health",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [{"encoding": "no-op", "host": ["{{ env "PPS_AUTH_URL" }}"], "url_pattern": "{{ env "PPS_AUTH_PREFIX" }}/health"}]
    },
    {
      "endpoint": "/api/v1/auth/.well-known/openid-configuration",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [{"encoding": "no-op", "host": ["{{ env "PPS_AUTH_URL" }}"], "url_pattern": "{{ env "PPS_AUTH_PREFIX" }}/.well-known/openid-configuration"}]
    },
    {
      "endpoint": "/api/v1/auth/.well-known/jwks.json",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [{"encoding": "no-op", "host": ["{{ env "PPS_AUTH_URL" }}"], "url_pattern": "{{ env "PPS_AUTH_PREFIX" }}/.well-known/jwks.json"}]
    },
    {
      "endpoint": "/api/v1/auth/oauth/authorize",
      "method": "GET",
      "input_query_strings": ["redirect_uri", "state", "code_challenge"],
      "output_encoding": "no-op",
      "extra_config": {"qos/ratelimit/router": {"max_rate": 50, "capacity": 50, "client_max_rate": 10, "client_capacity": 10, "strategy": "ip"}},
      "backend": [{"encoding": "no-op", "host": ["{{ env "PPS_AUTH_URL" }}"], "url_pattern": "{{ env "PPS_AUTH_PREFIX" }}/oauth/authorize"}]
    },
    {
      "endpoint": "/api/v1/auth/oauth/token",
      "method": "POST",
      "input_headers": ["Content-Type", "X-Request-ID"],
      "output_encoding": "no-op",
      "extra_config": {"qos/ratelimit/router": {"max_rate": 30, "capacity": 30, "client_max_rate": 5, "client_capacity": 5, "strategy": "ip"}},
      "backend": [{"encoding": "no-op", "host": ["{{ env "PPS_AUTH_URL" }}"], "url_pattern": "{{ env "PPS_AUTH_PREFIX" }}/oauth/token"}]
    },
    {
      "endpoint": "/api/v1/auth/oauth/logout",
      "method": "GET",
      "input_query_strings": ["logout_uri"],
      "output_encoding": "no-op",
      "backend": [{"encoding": "no-op", "host": ["{{ env "PPS_AUTH_URL" }}"], "url_pattern": "{{ env "PPS_AUTH_PREFIX" }}/oauth/logout"}]
    },
    {
      "endpoint": "/api/v1/auth/me",
      "method": "GET",
      "input_headers": ["Authorization", "X-Request-ID"],
      "output_encoding": "no-op",
      "extra_config": {"qos/ratelimit/router": {"max_rate": 100, "capacity": 100, "client_max_rate": 20, "client_capacity": 20, "strategy": "ip"}},
      "backend": [{"encoding": "no-op", "host": ["{{ env "PPS_AUTH_URL" }}"], "url_pattern": "{{ env "PPS_AUTH_PREFIX" }}/me"}]
    },
    {{ template "authEndpoint" dict "path" "/api/v1/auth/me/consents" "method" "GET" "backendPath" "/me/consents" }},
    {{ template "authEndpoint" dict "path" "/api/v1/auth/me/consents" "method" "POST" "backendPath" "/me/consents" }},
    {{ template "authEndpoint" dict "path" "/api/v1/auth/roles" "method" "GET" "backendPath" "/roles" }},
    {{ template "authEndpoint" dict "path" "/api/v1/auth/roles" "method" "POST" "backendPath" "/roles" }},
    {{ template "authEndpoint" dict "path" "/api/v1/auth/roles/{roleId}" "method" "GET" "backendPath" "/roles/{roleId}" }},
    {{ template "authEndpoint" dict "path" "/api/v1/auth/roles/{roleId}/permissions" "method" "PUT" "backendPath" "/roles/{roleId}/permissions" }},
    {{ template "authEndpoint" dict "path" "/api/v1/auth/users/{userId}/roles/{roleId}" "method" "PUT" "backendPath" "/users/{userId}/roles/{roleId}" }},
    {{ template "authEndpoint" dict "path" "/api/v1/auth/users/{userId}/roles/{roleId}" "method" "DELETE" "backendPath" "/users/{userId}/roles/{roleId}" }},
    {{ template "authEndpoint" dict "path" "/api/v1/auth/organizations" "method" "GET" "backendPath" "/organizations" }},
    {{ template "authEndpoint" dict "path" "/api/v1/auth/organizations" "method" "POST" "backendPath" "/organizations" }},
    {{ template "authEndpoint" dict "path" "/api/v1/auth/organizations/{organizationId}/members/{userId}" "method" "PUT" "backendPath" "/organizations/{organizationId}/members/{userId}" }},
    {
      "endpoint": "/api/v1/auth/me",
      "method": "PUT",
      "input_headers": ["Authorization", "Content-Type", "X-Request-ID"],
      "output_encoding": "no-op",
      "extra_config": {"qos/ratelimit/router": {"max_rate": 50, "capacity": 50, "client_max_rate": 10, "client_capacity": 10, "strategy": "ip"}},
      "backend": [{"encoding": "no-op", "host": ["{{ env "PPS_AUTH_URL" }}"], "url_pattern": "{{ env "PPS_AUTH_PREFIX" }}/me"}]
    },
    {
      "endpoint": "/api/v1/catalog/health",
      "method": "GET",
      "output_encoding": "no-op",
      "extra_config": {"qos/ratelimit/router": {"max_rate": 50, "capacity": 50, "client_max_rate": 10, "client_capacity": 10, "strategy": "ip"}},
      "backend": [{"encoding": "no-op", "sd": "static", "host": ["{{ env "PPS_CATALOG_URL" }}"], "url_pattern": "/health"}]
    },
    {
      "endpoint": "/api/v1/catalog/api-docs/openapi.json",
      "method": "GET",
      "output_encoding": "no-op",
      "extra_config": {"qos/ratelimit/router": {"max_rate": 20, "capacity": 20, "client_max_rate": 5, "client_capacity": 5, "strategy": "ip"}},
      "backend": [{"encoding": "no-op", "sd": "static", "host": ["{{ env "PPS_CATALOG_URL" }}"], "url_pattern": "/api-docs/openapi.json", "extra_config": {"qos/http-cache": {"shared": true}}}]
    },
    {
      "endpoint": "/api/v1/catalog/assets/products/{name}",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Accept", "If-None-Match"],
      "backend": [{"encoding": "no-op", "sd": "static", "host": ["{{ env "PPS_CATALOG_URL" }}"], "url_pattern": "/assets/products/{name}"}]
    },
    {
      "endpoint": "/api/v1/catalog/products",
      "method": "GET",
      "input_query_strings": ["pageSize", "cursor", "brandId", "categoryId", "saleType", "minPrice", "maxPrice", "q", "sort", "direction"],
      "input_headers": ["If-None-Match", "X-Request-ID"],
      "output_encoding": "no-op",
      "extra_config": {"qos/ratelimit/router": {"max_rate": 200, "capacity": 200, "client_max_rate": 30, "client_capacity": 30, "strategy": "ip"}},
      "backend": [{"encoding": "no-op", "sd": "static", "host": ["{{ env "PPS_CATALOG_URL" }}"], "url_pattern": "/products", "extra_config": {"qos/http-cache": {"max_items": 1000, "max_size": 134217728}}}]
    },
    {
      "endpoint": "/api/v1/catalog/products/{id}",
      "method": "GET",
      "input_headers": ["If-None-Match", "X-Request-ID"],
      "output_encoding": "no-op",
      "extra_config": {"qos/ratelimit/router": {"max_rate": 200, "capacity": 200, "client_max_rate": 30, "client_capacity": 30, "strategy": "ip"}},
      "backend": [{"encoding": "no-op", "sd": "static", "host": ["{{ env "PPS_CATALOG_URL" }}"], "url_pattern": "/products/{id}", "extra_config": {"qos/http-cache": {"max_items": 1000, "max_size": 134217728}}}]
    },
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/products" "method" "GET" "backendPath" "/admin/products" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/products" "method" "POST" "backendPath" "/admin/products" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/products/{id}" "method" "PATCH" "backendPath" "/admin/products/{id}" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/products/{id}" "method" "DELETE" "backendPath" "/admin/products/{id}" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/vehicle-models" "method" "GET" "backendPath" "/admin/vehicle-models" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/vehicle-models" "method" "POST" "backendPath" "/admin/vehicle-models" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/vehicle-generations" "method" "GET" "backendPath" "/admin/vehicle-generations" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/vehicle-generations" "method" "POST" "backendPath" "/admin/vehicle-generations" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/vehicle-trims" "method" "GET" "backendPath" "/admin/vehicle-trims" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/vehicle-trims" "method" "POST" "backendPath" "/admin/vehicle-trims" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/brands" "method" "GET" "backendPath" "/admin/brands" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/brands" "method" "POST" "backendPath" "/admin/brands" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/categories" "method" "GET" "backendPath" "/admin/categories" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/categories" "method" "POST" "backendPath" "/admin/categories" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/engines" "method" "POST" "backendPath" "/admin/engines" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/vehicle-configurations" "method" "POST" "backendPath" "/admin/vehicle-configurations" }},
    {{ template "adminEndpoint" dict "path" "/api/v1/catalog/admin/product-fitments" "method" "POST" "backendPath" "/admin/product-fitments" }}
  ]
}

{{ define "authEndpoint" }}
{
  "endpoint": "{{ .path }}",
  "method": "{{ .method }}",
  "input_headers": ["Authorization", "Content-Type", "X-Request-ID"],
  "input_query_strings": ["organizationId"],
  "output_encoding": "no-op",
  "extra_config": {
    "qos/ratelimit/router": {"max_rate": 50, "capacity": 50, "client_max_rate": 10, "client_capacity": 10, "strategy": "ip"}
  },
  "backend": [{
    "encoding": "no-op",
    "host": ["{{ env "PPS_AUTH_URL" }}"],
    "url_pattern": "{{ env "PPS_AUTH_PREFIX" }}{{ .backendPath }}"
  }]
}
{{ end }}

{{ define "adminEndpoint" }}
{
  "endpoint": "{{ .path }}",
  "method": "{{ .method }}",
  "input_headers": ["Authorization", "Content-Type", "X-PPS-Admin-Key", "X-Request-ID"],
  "output_encoding": "no-op",
  "extra_config": {
    "qos/ratelimit/router": {"max_rate": 50, "capacity": 50, "client_max_rate": 10, "client_capacity": 10, "strategy": "ip"}
    {{ if eq (env "PPS_AUTH_MODE") "jwt" }},
    "auth/validator": {
      "alg": "RS256",
      "jwk_url": "{{ env "PPS_JWKS_URL" }}",
      "cache": true,
      "cache_duration": 900,
      "issuer": "{{ env "PPS_JWT_ISSUER" }}",
      "scopes_key": "scope",
      "scopes_matcher": "all",
      "scopes": ["pps-api/catalog.admin"],
      "propagate_claims": [["sub", "X-PPS-User-ID"]]
    }
    {{ end }}
  },
  "backend": [{
    "encoding": "no-op",
    "sd": "static",
    "host": ["{{ env "PPS_CATALOG_URL" }}"],
    "url_pattern": "{{ .backendPath }}"
  }]
}
{{ end }}
